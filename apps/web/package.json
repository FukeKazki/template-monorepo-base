{
  "name": "@repo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev -c wrangler.jsonc -c ../api/wrangler.jsonc",
    "codegen": "tsr generate && pnpm dlx openapi-typescript@7.13.0 ../api/openapi.json -o src/lib/open-api/schema.gen.ts && wrangler types",
    "build": "pnpm codegen && tsc -b tsconfig.json tsconfig.worker.json && vite build",
    "deploy": "wrangler deploy",
    "preview": "vite preview",
    "typecheck": "pnpm codegen && tsc -b tsconfig.json tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fukke0906/definefn": "^0.1.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.2",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-table": "^8.21.3",
    "better-result": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.33",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "jsdom": "30.0.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "openapi-msw": "^2.0.0",
    "playwright": "^1.62.1",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "^4.127.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
