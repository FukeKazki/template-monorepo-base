{
  "openapi": "3.1.0",
  "info": {
    "title": "Product Management API",
    "description": "商品管理APIの仕様。apps/api の実装から自動生成される。",
    "version": "0.0.0"
  },
  "paths": {
    "/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "商品一覧を取得する",
        "responses": {
          "200": {
            "description": "商品一覧",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createProduct",
        "summary": "商品を登録する",
        "responses": {
          "201": {
            "description": "登録した商品",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "400": {
            "description": "リクエストが不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductRequest"
              }
            }
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "operationId": "getProduct",
        "summary": "商品詳細を取得する",
        "responses": {
          "200": {
            "description": "商品詳細",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "404": {
            "description": "商品が見つからない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true
          }
        ]
      },
      "put": {
        "operationId": "updateProduct",
        "summary": "商品を更新する",
        "responses": {
          "200": {
            "description": "更新した商品",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "400": {
            "description": "リクエストが不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "商品が見つからない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProductRequest"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteProduct",
        "summary": "商品を削除する",
        "responses": {
          "204": {
            "description": "削除成功"
          },
          "404": {
            "description": "商品が見つからない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "price": {
            "type": "number"
          },
          "imageUrl": {
            "type": "string",
            "minLength": 1,
            "format": "uri"
          }
        },
        "required": [
          "id",
          "name",
          "price",
          "imageUrl"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "CreateProductRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "price": {
            "type": "number"
          },
          "imageUrl": {
            "type": "string",
            "minLength": 1,
            "format": "uri"
          }
        },
        "required": [
          "name",
          "price",
          "imageUrl"
        ]
      },
      "UpdateProductRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "price": {
            "type": "number"
          },
          "imageUrl": {
            "type": "string",
            "minLength": 1,
            "format": "uri"
          }
        },
        "required": [
          "name",
          "price",
          "imageUrl"
        ]
      }
    }
  }
}
