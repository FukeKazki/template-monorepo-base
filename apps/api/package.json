{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app-type": {
      "types": "./dist-types/src/index.d.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "codegen": "wrangler types",
    "build:types": "pnpm codegen && tsc -p tsconfig.build.json",
    "build": "pnpm build:types && wrangler deploy --dry-run --outdir dist",
    "typecheck": "pnpm build:types",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "wrangler d1 execute DB --local --file=./drizzle/seed.sql"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.3",
    "@standard-schema/spec": "^1.1.0",
    "better-result": "^3.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "^4.127.1"
  }
}
